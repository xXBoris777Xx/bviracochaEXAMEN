<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bviracochaEXAMEN.Resumen"
             Title="Resumen">
    <ScrollView>
        <ScrollView.Content>
            <VerticalStackLayout Padding="20" Spacing="15">
                <VerticalStackLayout.Children>
                    <Label x:Name="lblUsuarioConectado" HorizontalOptions="End" FontAttributes="Italic" />
                    <Label Text="RESUMEN" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                    <!-- Grid: 9 Filas x 2 Columnas -->
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                          ColumnDefinitions="*, *"
                          RowSpacing="12">
                        <Grid.Children>
                            <Label Text="Nombre:" Grid.Row="0" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblNombre" Grid.Row="0" Grid.Column="1" />

                            <Label Text="Apellido:" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblApellido" Grid.Row="1" Grid.Column="1" />

                            <Label Text="Edad:" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblEdad" Grid.Row="2" Grid.Column="1" />

                            <Label Text="Fecha:" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblFecha" Grid.Row="3" Grid.Column="1" />

                            <Label Text="Ciudad:" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblCiudad" Grid.Row="4" Grid.Column="1" />

                            <Label Text="País:" Grid.Row="5" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblPais" Grid.Row="5" Grid.Column="1" />

                            <Label Text="Monto Inicial:" Grid.Row="6" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblMontoInicial" Grid.Row="6" Grid.Column="1" />

                            <Label Text="Pago Mensual:" Grid.Row="7" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblPagoMensual" Grid.Row="7" Grid.Column="1" />

                            <Label Text="Pago Total:" Grid.Row="8" Grid.Column="0" FontAttributes="Bold" />
                            <Label x:Name="lblPagoTotal" Grid.Row="8" Grid.Column="1" TextColor="Green" FontAttributes="Bold" />
                        </Grid.Children>
                    </Grid>
                </VerticalStackLayout.Children>
            </VerticalStackLayout>
        </ScrollView.Content>
    </ScrollView>
</ContentPage>
