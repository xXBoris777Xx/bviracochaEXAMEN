<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bviracochaEXAMEN.Registro"
             Title="Registro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <!-- Usuario Conectado superior -->
            <Label x:Name="lblUsuarioConectado" HorizontalOptions="End" FontAttributes="Italic" />

            <Label Text="REGISTRO" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- Grid 1: 5 Filas x 2 Columnas -->
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="10">
                <Label Text="FECHA" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" />
                <DatePicker x:Name="dpFecha" Grid.Row="0" Grid.Column="1" />

                <Label Text="PAÍS" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
                <Picker x:Name="pkPais" Grid.Row="1" Grid.Column="1" Title="Seleccione País">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Ecuador</x:String>
                            <x:String>Colombia</x:String>
                            <x:String>Perú</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="CIUDAD" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" />
                <Picker x:Name="pkCiudad" Grid.Row="2" Grid.Column="1" Title="Seleccione Ciudad">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Quito</x:String>
                            <x:String>Cuenca</x:String>
                            <x:String>Guayaquil</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Label Text="Monto Inicial" Grid.Row="3" Grid.Column="0" VerticalOptions="Center" />
                <Entry x:Name="txtMontoInicial" Grid.Row="3" Grid.Column="1" Keyboard="Numeric" Placeholder="INGRESE EL MONTO INICIAL" />

                <Button Text="Calcular Pago mensual"
                        Grid.Row="4" Grid.Column="0"
                        Style="{StaticResource EstiloBotonGlobal}"
                        Clicked="OnCalcularClicked" />

                <Entry x:Name="txtPagoMensual" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Placeholder="Pago Mensual" />
            </Grid>

            <BoxView HeightRequest="1" Color="Gray" Margin="0,10" />

            <!-- Grid 2: 2 Filas x 3 Columnas -->
            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *, *" ColumnSpacing="5" RowSpacing="5">
                <Label Text="NOMBRE" Grid.Row="0" Grid.Column="0" />
                <Label Text="APELLIDO" Grid.Row="0" Grid.Column="1" />
                <Label Text="EDAD" Grid.Row="0" Grid.Column="2" />

                <Entry x:Name="txtNombre" Grid.Row="1" Grid.Column="0" Placeholder="Nombre" />
                <Entry x:Name="txtApellido" Grid.Row="1" Grid.Column="1" Placeholder="Apellido" />
                <Entry x:Name="txtEdad" Grid.Row="1" Grid.Column="2" Keyboard="Numeric" Placeholder="Edad" />
            </Grid>

            <!-- Botón Ver Resumen -->
            <Button Text="Ver resumen"
                    Style="{StaticResource EstiloBotonGlobal}"
                    Clicked="OnVerResumenClicked"
                    Margin="0,15,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
